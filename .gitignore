# runtime data — leads, results, logs, saved API keys (never commit: PII + secrets)
data/
.env

# generated by the Schedule tab (local paths + chosen flags)
run-scheduled.bat

# Google service-account credentials — never commit
*service-account*.json
*credentials*.json

# python
__pycache__/
*.pyc
.venv/
venv/

# UI: dependencies live outside this folder (see build-ui.bat) and the bundle is built
ui/node_modules/
webapp/dist/

# Next.js screens: node_modules and .next are junctions into C:\ClaudeDeps\leadgen-web
web/node_modules
web/.next
web/tsconfig.tsbuildinfo

# written automatically before any config change, so the previous version survives
config/*.backup.json
